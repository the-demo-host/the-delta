{
  "name": "live-qa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,web,tests \"tsx watch src/server/index.ts\" \"vite\" \"npm run progress:watch\"",
    "live": "concurrently -n api,build,tests \"tsx watch src/server/index.ts\" \"vite build --watch\" \"npm run progress:watch\"",
    "build": "vite build",
    "start": "npm run progress && npm run build && tsx src/server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "progress": "vitest run --reporter=json --outputFile=data/progress.json || true",
    "progress:watch": "vitest watch --reporter=json --outputFile=data/progress.json",
    "reset": "tsx src/server/reset.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "@vitejs/plugin-react": "^6.2.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3"
  }
}
